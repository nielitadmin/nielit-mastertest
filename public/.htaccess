# 1. Disable Directory Browsing (Security)
Options -Indexes

# 2. Prevent viewing of hidden files (like this .htaccess file)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Custom 404 Error Document (dynamic path — works on any server)
ErrorDocument 404 /404.php

# 4. Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dynamically detect the base path (works on localhost and live server)
    RewriteBase /

    # Allow direct access to real files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else to index.php (if you add a front controller later)
    # RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# 5. Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# 6. PHP file caching — disable for .php files
<FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
</FilesMatch>
